# Public DNS names pointing to this Docker host
PROD_DOMAIN=planung.example.ch
TEST_API_DOMAIN=test-api.example.ch

# GitHub Pages browser origin (origin only, no repository path and no trailing slash)
GITHUB_PAGES_ORIGIN=https://YOUR-GITHUB-USER.github.io

# Production database + app
PROD_POSTGRES_DB=hoeckeler
PROD_POSTGRES_USER=hoeckeler
PROD_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PRODUCTION_DB_PASSWORD
PROD_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PROD_BOOTSTRAP_ADMIN=admin
PROD_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_ADMIN_PASSWORD

# Test database + app
TEST_POSTGRES_DB=hoeckeler_test
TEST_POSTGRES_USER=hoeckeler_test
TEST_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_TEST_DB_PASSWORD
TEST_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TEST_BOOTSTRAP_ADMIN=admin
TEST_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_TEST_ADMIN_PASSWORD

# Test notifications are forcibly redirected here.
TEST_EMAIL_REDIRECT=your-test-mail@example.com
TEST_SMS_REDIRECT=+41000000000
